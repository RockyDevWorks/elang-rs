phonemes {
  consonants {
    phoneme "t" {
      roman "t"
      when {
        word-position "initial"
        word-position "initial"
        previous-phoneme "s"
        previous-phoneme "z"
      }
    }
    phoneme "s" {
      roman "s"
    }
    phoneme "z" {
      roman "z"
    }
  }
  vowels {
    phoneme "a" {
      roman "a"
    }
  }
}
