phonemes {
    consonants {
        phoneme "s" {
            roman "s"
        }
        phoneme "t" {
            roman "t"
            when {
                word-position "initial"
                word-position "initial"
                previous-phoneme "s"
                previous-phoneme "z"
            }
        }
        phoneme "z" {
            roman "z"
        }
    }
    vowels {
        phoneme "a" {
            roman "a"
        }
    }
}
