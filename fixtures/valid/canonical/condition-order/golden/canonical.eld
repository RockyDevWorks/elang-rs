phonemes {
    consonants {
        phoneme "s" {
            roman "s"
        }
        phoneme "t" {
            roman "t"
            when {
                word-position "initial"
                syllable-position "coda"
                previous-phoneme "s"
                next-phoneme "a"
            }
        }
    }
    vowels {
        phoneme "a" {
            roman "a"
        }
    }
}
