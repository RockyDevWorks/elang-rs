phonemes {
    consonants {
        phoneme "p" {
            roman "p"
            when {
                word-position "initial"
                syllable-position "onset"
                word-position "initial"
                syllable-position "onset"
                word-position "initial"
                syllable-position "onset"
                word-position "initial"
                syllable-position "onset"
                word-position "initial"
                syllable-position "onset"
                word-position "initial"
                syllable-position "onset"
                word-position "initial"
                syllable-position "onset"
                word-position "initial"
                syllable-position "onset"
            }
        }
    }
    vowels {
        phoneme "a" {
            roman "a"
        }
    }
}
