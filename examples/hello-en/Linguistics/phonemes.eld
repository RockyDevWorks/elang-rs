phonemes {
    consonants {
        phoneme "p" {
            roman "p"
            allophone "pʰ" {
                roman "ph"
            }
        }
        phoneme "t" {
            roman "t"
            allophone "tʰ" {
                roman "th"
                when {
                    word-position "initial"
                }
            }
        }
        phoneme "k" {
            roman "k"
        }
        phoneme "s" {
            roman "s"
        }
        phoneme "tʃ" {
            roman "ch"
        }
        phoneme "n" {
            roman "n"
        }
        phoneme "l" {
            roman "l"
        }
        phoneme "ɹ" {
            roman "r"
        }
        phoneme "m" {
            roman "m"
        }
    }
    vowels {
        phoneme "æ" {
            roman "a"
        }
        phoneme "eɪ" {
            roman "ay"
        }
        phoneme "i" {
            roman "ee"
        }
        phoneme "u" {
            roman "oo"
        }
        phoneme "ə" {
            roman "uh"
        }
    }
}
