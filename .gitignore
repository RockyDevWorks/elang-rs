# Rust build output
/target
**/*.rs.bk

# Keep Cargo.lock committed: this repo ships binaries and requires reproducible,
# pinned dependency builds (see SECURITY.md). Do NOT ignore Cargo.lock.

# Editor / OS noise
.DS_Store
Thumbs.db
*.swp
*~

# Local scratch logs / command-capture files used during development.
# Root-anchored so they never match tracked data files (e.g. specs/sources/**/*.txt).
/*.log
/*.txt
build_*.log
test_*.log
clippy_*.log

# Fuzzing artifacts
/fuzz/target
/fuzz/corpus
/fuzz/artifacts

# Kiro spec execution metadata (local session/execution IDs + timestamps, not
# project content).
.kiro/specs/**/tasks.meta.json

# Zensical documentation site output (built in CI by docs.yml and published to
# GitHub Pages; the generated artifact is not committed).
/site
cache/
