{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^crates/elang-server/Dockerfile$/"
      ],
      "matchStrings": [
        "ARG (?:RUST|DEBIAN)_IMAGE=(?<depName>[^:\\s]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": [
        "docker"
      ],
      "pinDigests": true
    },
    {
      "description": "These actions/repos are pinned to commit SHAs by repo policy (manual control) — disable Renovate's lookup to suppress the github-tags 'Could not determine new digest' failures on the Dependency Dashboard.",
      "matchPackageNames": [
        "dtolnay/rust-toolchain",
        "rustsec/audit-check",
        "actions/dependency-review-action"
      ],
      "enabled": false
    }
  ]
}
