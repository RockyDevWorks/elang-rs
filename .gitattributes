# ELANG is a byte-exact format; keep line endings deterministic across platforms.
* text=auto eol=lf

# Treat known binary / fixture artifacts as binary so Git never rewrites bytes.
*.elang   binary
*.eld     binary
*.epf     binary
*.bin     binary
*.sha256  text eol=lf
fixtures/**/golden/** binary

# Pinned normative source documents: never rewrite bytes (their SHA-256 is
# recorded in specs/sources/SOURCES.md).
specs/sources/*.pdf   binary
specs/sources/*.html  binary
# UCD source files: keep exact bytes so their pinned SHA-256 stays stable.
specs/sources/ucd-18.0.0/*.txt binary
