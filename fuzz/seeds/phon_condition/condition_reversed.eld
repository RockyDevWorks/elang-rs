phonemes {
  consonants {
    phoneme "t" {
      roman "t"
      when {
        previous-phoneme "s"
        next-phoneme "a"
        syllable-position "coda"
        word-position "initial"
      }
    }
    phoneme "s" {
      roman "s"
    }
  }
  vowels {
    phoneme "a" {
      roman "a"
    }
  }
}
